{
  "name": "@budsbox/constraints",
  "version": "3.0.2",
  "homepage": "https://github.com/budsbox/seed/tree/trunk/constraints",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:vite:prepack; run p:ts:prepack;",
    "setup": "[ -f dist/index.cjs ] && exit 0; run p:vite:build; run p:ts:build",
    "watch": "run p:ts:watch --preserveWatchOutput & run p:vite:watch --emptyOutDir false"
  },
  "dependencies": {
    "@types/micromatch": "^4.0.10",
    "@yarnpkg/types": "^4.0.1",
    "micromatch": "^4.0.8",
    "semver": "^7.7.4",
    "semver-intersect": "^1.5.0",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@budsbox/builder_vite": "workspace:^",
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.39.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.1",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sass-embedded": "^1.93.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "vite-plugin-react-rich-svg": "^1.3.0"
  },
  "packageManager": "yarn@4.13.0"
}
