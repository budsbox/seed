{
  "name": "@budsbox/constraints",
  "version": "3.0.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "commonjs",
  "imports": {
    "#package.json": "./package.json",
    "#@": {
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack",
    "setup": "[ -f dist/dist.tsbuildinfo ] || run p:lib:setup"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@types/micromatch": "^4.0.9",
    "@yarnpkg/types": "^4.0.1",
    "micromatch": "^4.0.8",
    "semver": "^7.7.2",
    "semver-intersect": "^1.5.0",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.2",
    "@types/semver": "^7",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "packageManager": "yarn@4.9.2"
}
