    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "execa": "^9.5.2",
    "globals": "^15.14.0",
    "meow": "^13.2.0",
    "sass": "^1.77.6",
    "tsconfig-to-swcconfig": "^2.8.0",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "@budsbox/linting": "workspace:^"
