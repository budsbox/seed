  "type": "module",
  "imports": {
    "#vite-config-factory.mjs": {
      "types": "./src/vite-config-factory.d.mjs.ts",
      "import": "./src/vite-config-factory.mjs"
    },
    "#package.json": "./package.json",
    "#lib-builder": {
      "import": "./dist/lib-builder.js"
    }
  },
  "exports": {
    "./vite-config-factory.mjs": {
      "types": "./src/vite-config-factory.d.mjs.ts",
      "import": "./src/vite-config-factory.mjs"
    },
    "./lib-builder": {
      "import": "./dist/lib-builder.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "budsbox-build-lib": "./dist/bin/build-lib.js"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "name": "echo $npm_package_name"
  },
  "dependencies": {
    "@budsbox/iso-utils": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/node-utils": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "execa": "^9.6.1",
    "globals": "^16.5.0",
    "meow": "^13.2.0",
    "sass": "^1.94.2",
    "tsconfig-to-swcconfig": "^2.8.1",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@budsbox/linting": "workspace:^"
  },
  "packageManager": "yarn@4.9.2"
