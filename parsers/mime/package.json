{
  "name": "@budsbox/parsers-mime",
  "version": "0.0.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#parser": {
      "import": {
        "types": "./dist/parser.d.ts",
        "default": "./dist/parser.js"
      }
    }
  },
  "exports": {
    ".": {
      "umd": {
        "types": "./dist/index.d.ts",
        "production": "./dist/parser.min.umd.js",
        "default": "./dist/parser.umd.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "production": "./dist/parser.min.js",
        "default": "./dist/parser.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "production": "./dist/parser.min.cjs",
        "default": "./dist/parser.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "run p:peggy:es; run p:ts:build",
    "name": "echo $npm_package_name",
    "prepack": "yarn p:peggy:prepack; run p:ts:prepack",
    "test": "yarn vitest",
    "watch": "yarn p:peggy:watch & yarn p:ts:watch"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@types/node": "^22.15.2",
    "@types/whatwg-mimetype": "^3.0.2",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.26.0",
    "peggy": "^5.0.6",
    "typescript": "^5.8.3",
    "vitest": "^4.0.1",
    "whatwg-mimetype": "^4.0.0"
  },
  "packageManager": "yarn@4.9.2"
}
