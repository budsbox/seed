{
  "name": "@budsbox/ui-components-merge-2",
  "version": "0.0.1",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "sideEffects": [
    "./**/*.scss",
    "./**/*.css"
  ],
  "type": "module",
  "imports": {
    "#types": {
      "types": "./dist/types.d.ts"
    },
    "#ui": {
      "import": {
        "development": "./src/ui/index.ts",
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/index.mjs"
      }
    },
    "#model": {
      "import": {
        "development": "./src/model.ts",
        "types": "./dist/model.d.ts",
        "default": "./dist/index.mjs"
      }
    },
    "#lib": {
      "import": {
        "development": {
          "default": "./src/lib.ts"
        },
        "production": {
          "types": "./dist/lib.d.ts",
          "default": "./dist/lib.js"
        },
        "types": "./dist/lib.d.ts"
      }
    },
    "#*.css": "./dist/*.css",
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "import": {
        "budsbox": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./*.css": "./dist/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.css"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "NODE_ENV=production yarn vite build; yarn p:ts:build",
    "serve": "run p:serve"
  },
  "dependencies": {
    "@budsbox/lib-class-name": "workspace:^",
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-random": "workspace:^",
    "@budsbox/lib-react": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@types/node": "^22.15.2",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/builder_vite": "workspace:^",
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-browser-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "clsx": "^2.1.1",
    "eslint": "^9.26.0",
    "eslint-plugin-perfectionist": "*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass-embedded": "^1.92.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.5"
  },
  "peerDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "packageManager": "yarn@4.9.2"
}
