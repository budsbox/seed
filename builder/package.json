{
  "name": "@budsbox/builder",
  "version": "0.1.4",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "bin": {
    "budsbox-build-lib": "./dist/bin/build-lib.js",
    "budsbox-update-ts-references": "./dist/bin/update-ts-references.js"
  },
  "imports": {
    "#package.json": "./package.json",
    "#lib-builder": {
      "import": "./dist/lib-builder.js"
    }
  },
  "exports": {
    "./lib-builder": {
      "import": "./dist/lib-builder.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-node": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@yarnpkg/cli": "^4.8.1",
    "@yarnpkg/fslib": "^3.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "execa": "^9.5.2",
    "globals": "^15.14.0",
    "json5": "^2.2.3",
    "meow": "^13.2.0",
    "sass": "^1.77.6",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "@budsbox/linting": "workspace:^",
    "@yarnpkg/core": "^4.3.1"
  },
  "packageManager": "yarn@4.5.3",
  "peerDependencies": {
    "@yarnpkg/core": "^4.3.1"
  }
}
