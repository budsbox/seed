{
  "name": "@budsbox/builder",
  "version": "0.1.4",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#lib-builder": {
      "import": "./dist/lib-builder.js"
    }
  },
  "exports": {
    "./lib-builder": {
      "import": "./dist/lib-builder.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "budsbox-build-lib": "./dist/bin/build-lib.js",
    "budsbox-update-ts-references": "./dist/bin/update-ts-references.js"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack",
    "setup": "[ -f dist/dist.tsbuildinfo ] || run p:lib:setup"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-node": "workspace:^",
    "@budsbox/lib-yarn": "workspace:^",
    "@types/node": "^22.15.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@yarnpkg/cli": "^4.8.1",
    "@yarnpkg/fslib": "^3.1.2",
    "@yarnpkg/types": "^4.0.1",
    "execa": "^9.5.2",
    "json5": "^2.2.3",
    "meow": "^13.2.0",
    "sass": "^1.77.6",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typescript": "^5.8.3",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "@yarnpkg/core": "^4.3.1",
    "eslint": "^9.26.0"
  },
  "peerDependencies": {
    "@yarnpkg/core": "^4.3.1"
  },
  "packageManager": "yarn@4.9.2"
}
