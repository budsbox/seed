{
  "name": "@budsbox/eslint",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#types": {
      "import": {
        "default": "./dist/types.js",
        "types": "./dist/types.d.ts"
      }
    },
    "#const": {
      "import": {
        "default": "./dist/const.js",
        "types": "./dist/const.d.ts"
      }
    },
    "#configs": {
      "import": {
        "default": "./dist/configs/index.js",
        "types": "./dist/configs/index.d.ts"
      }
    },
    "#lib": {
      "import": {
        "default": "./dist/lib.js",
        "types": "./dist/lib.d.ts"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "workspaces": [
    "configs/*",
    "presets/*"
  ],
  "scripts": {
    "name": "echo $npm_package_name"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-extensions": "workspace:^",
    "@budsbox/lib-node": "workspace:^",
    "@types/eslint": "^8.56.12",
    "@types/node": "^22.10.5",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.10.0",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "packageManager": "yarn@4.8.1"
}
