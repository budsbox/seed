{
  "name": "@budsbox/eslint",
  "version": "1.2.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#types": {
      "import": {
        "default": "./dist/types.js",
        "types": "./dist/types.d.ts"
      }
    },
    "#const": {
      "import": {
        "default": "./dist/const.js",
        "types": "./dist/const.d.ts"
      }
    },
    "#configs": {
      "import": {
        "default": "./dist/configs/index.js",
        "types": "./dist/configs/index.d.ts"
      }
    },
    "#lib": {
      "import": {
        "default": "./dist/lib.js",
        "types": "./dist/lib.d.ts"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "workspaces": [
    "configs/*",
    "presets/*"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-extensions": "workspace:^",
    "@budsbox/lib-node": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.2",
    "globals": "^16.1.0",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.32.1"
  },
  "peerDependencies": {
    "eslint": "^9.26.0"
  },
  "packageManager": "yarn@4.9.2"
}
