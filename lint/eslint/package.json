{
  "name": "@budsbox/eslint",
  "version": "1.3.0",
  "homepage": "https://github.com/budsbox/seed/tree/trunk/lint/eslint",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#types": {
      "import": {
        "default": "./dist/types.js",
        "types": "./dist/types.d.ts"
      }
    },
    "#const": {
      "import": {
        "default": "./dist/const.js",
        "types": "./dist/const.d.ts"
      }
    },
    "#configs": {
      "import": {
        "default": "./dist/configs/index.js",
        "types": "./dist/configs/index.d.ts"
      }
    },
    "#lib": {
      "import": {
        "default": "./dist/lib.js",
        "types": "./dist/lib.d.ts"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "workspaces": [
    "configs/*",
    "presets/*"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack",
    "setup": "run p:lib:setup; run p:lib:setup-worktree;",
    "watch": "run p:ts:watch"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-extensions": "workspace:^",
    "@budsbox/lib-node": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@eslint/js": "^9.39.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.1",
    "globals": "^17.4.0",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript-eslint": "^8.57.2"
  },
  "peerDependencies": {
    "eslint": "^9.39.4"
  },
  "packageManager": "yarn@4.13.0"
}
