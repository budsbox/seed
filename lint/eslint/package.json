{
  "name": "@budsbox/eslint",
  "private": true,
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "workspaces": [
    "configs/*",
    "core",
    "presets/*"
  ],
  "packageManager": "yarn@4.8.1",
  "dependencies": {
    "@budsbox/eslint~core": "workspace:^",
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-extensions": "workspace:^",
    "@budsbox/lib-node": "workspace:^",
    "@types/eslint": "^8.56.12",
    "@types/node": "^22.10.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
