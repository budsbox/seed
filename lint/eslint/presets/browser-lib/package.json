{
  "name": "@budsbox/eslint_presets-browser-lib",
  "version": "1.0.5",
  "homepage": "https://github.com/budsbox/seed/tree/trunk/lint/eslint/presets/browser-lib",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack",
    "watch": "run p:ts:watch"
  },
  "dependencies": {
    "@budsbox/eslint_configs-react": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_configs-import": "workspace:^",
    "@budsbox/eslint_configs-typescript": "workspace:^",
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.39.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24",
    "@typescript-eslint/parser": "^8.57.2",
    "@typescript-eslint/type-utils": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.7.0",
    "globals": "^17.4.0",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "peerDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.13.0"
}
