{
  "name": "@budsbox/eslint_presets-node-lib",
  "version": "1.0.5",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/eslint_presets-lib": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_configs-import": "workspace:^",
    "@budsbox/eslint_configs-typescript": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@typescript-eslint/type-utils": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-perfectionist": "*",
    "globals": "^16.5.0",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "peerDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.9.2"
}
