{
  "name": "@budsbox/eslint_presets-browser-app",
  "version": "1.0.1",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/eslint_configs-import": "workspace:^",
    "@budsbox/eslint_configs-jsdoc": "workspace:^",
    "@budsbox/eslint_configs-prettier": "workspace:^",
    "@budsbox/eslint_configs-promise": "workspace:^",
    "@budsbox/eslint_configs-react": "workspace:^",
    "@budsbox/eslint_configs-typescript": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.2",
    "@typescript-eslint/parser": "^8.32.1",
    "@typescript-eslint/type-utils": "^8.32.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import-x": "^4.11.1",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-perfectionist": "*",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "typescript-eslint": "^8.32.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.26.0",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.26.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.9.2"
}
