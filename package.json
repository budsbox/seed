{
  "name": "@budsbox/root",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "sideEffects": [
    "./**/*.scss"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "workspaces": [
    "./build",
    "./builder",
    "./constraints",
    "./lib/*",
    "./linting",
    "./lint/*",
    "./tsconfigs",
    "./packages/*",
    "./ui/components/*",
    "./parse/*",
    "./gen/*"
  ],
  "scripts": {
    "autotag-all-since": "YARN_CHANGESET_BASE_REFS=$0 yarn workspaces foreach --parallel --since --no-private run p:autotag",
    "c": "run setup-constraints; yarn constraints",
    "cf": "yarn constraints --fix; yarn",
    "format": "run format-manifests && prettier --write .",
    "format-manifests": "sort-package-json \"**/package.json\"",
    "postinstall": "(run setup-builder; run relink) & run setup-constraints",
    "lint-staged": "lint-staged --config .lintstagedrc.js",
    "name": "echo $npm_package_name",
    "p:autotag": "cd $INIT_CWD; git tag -a \"$(yarn name)-v$(yarn p:version)\" -m ''",
    "p:create": "cd $INIT_CWD; budsbox-create",
    "p:eslint": "echo $INIT_CWD; cd $INIT_CWD; eslint --quiet ${@:-'.'}",
    "p:eslint:config": "cd $INIT_CWD; yarn node -e \"import c from './$(run p:eslint:config-filename)'; console.dir(await c, {depth: 6, colors: true});\" --input-type=module",
    "p:eslint:config-filename": "cd $INIT_CWD; echo eslint.config.*",
    "p:eslint:fix": "echo $INIT_CWD; cd $INIT_CWD; eslint --quiet --fix ${@:-'.'}",
    "p:eslint:per-file-config": "echo $INIT_CWD; cd $INIT_CWD; eslint --print-config",
    "p:eslint:staged": "cd $INIT_CWD; eslint --quiet --fix --no-warn-ignored --flag v10_config_lookup_from_file",
    "p:format": "cd $INIT_CWD; run p:format-manifest; prettier --write .",
    "p:format-manifest": "cd $INIT_CWD; sort-package-json package.json",
    "p:lib:browser:prepack": "cd $INIT_CWD; run p:vite:prepack; run p:ts:prepack;",
    "p:lib:iso:prepack": "cd $INIT_CWD; rm -rf dist; run p:ts:prepack;",
    "p:lib:node:prepack": "cd $INIT_CWD; rm -rf dist; run p:ts:prepack;",
    "p:lib:setup": "cd $INIT_CWD; run p:ts:build-lib; echo \"$(run name) was set up successfully\"",
    "p:lint": "cd $INIT_CWD; run p:eslint",
    "p:peggy": "cd $INIT_CWD; peggy --extra-options-file peggy.config.js",
    "p:peggy:build": "cd $INIT_CWD; run p:peggy --output dist/parser.js",
    "p:peggy:minify": "cd $INIT_CWD; NODE_ENV=production swc dist/parser.js --config module.type=$0 --out-file dist/$1",
    "p:peggy:prepack": "cd $INIT_CWD; NODE_ENV=production run p:peggy:build; run p:peggy:minify commonjs parser.min.cjs & run p:peggy:minify es6 parser.min.js",
    "p:peggy:trace": "cd $INIT_CWD; run p:peggy:watch --trace --test-file src/.peggy-test.txt",
    "p:peggy:watch": "cd $INIT_CWD; run p:peggy --watch --source-map",
    "p:prettier": "prettier --write $INIT_CWD/**",
    "p:scope-prefix": "$SHELL -c 'echo ${@/#/@budsbox/}' sh",
    "p:serve": "cd $INIT_CWD; run p:ts:watch --preserveWatchOutput & vite",
    "p:ts:build": "cd $INIT_CWD; tsc --build",
    "p:ts:build-lib": "cd $INIT_CWD; tsc --build tsconfig.lib.json",
    "p:ts:clean": "cd $INIT_CWD; tsc --build --clean;",
    "p:ts:config": "cd $INIT_CWD; tsc --showConfig --project ${0:-'.'}",
    "p:ts:force": "cd $INIT_CWD; tsc --build --force",
    "p:ts:prepack": "cd $INIT_CWD; NODE_ENV=production tsc --build --verbose",
    "p:ts:watch": "cd $INIT_CWD; run p:ts:build --watch --verbose --pretty",
    "p:ts:watch:no-clear": "cd $INIT_CWD; run p:ts:watch --preserveWatchOutput",
    "p:version": "cd $INIT_CWD; node -e 'console.log(require(\"./package.json\").version)'",
    "p:vite:build": "cd $INIT_CWD; NODE_ENV=production vite build;",
    "p:vite:prepack": "cd $INIT_CWD; run p:vite:build;",
    "p:vitest:watch": "cd $INIT_CWD; vitest watch --typecheck.enabled --typecheck.tsconfig tsconfig.test.json",
    "p:wsa": "cd $INIT_CWD; YARN_PREFER_INTERACTIVE=false yarn add $(run p:scope-prefix \"$@\")",
    "p:wsad": "cd $INIT_CWD; YARN_PREFER_INTERACTIVE=false yarn add -D $(run p:scope-prefix \"$@\")",
    "p:wsap": "cd $INIT_CWD; YARN_PREFER_INTERACTIVE=false yarn add -P $(run p:scope-prefix \"$@\")",
    "p:wsr": "cd $INIT_CWD; yarn remove $(run p:scope-prefix \"$@\")",
    "playground": "yarn workspace @budsbox/playground p:serve",
    "prepare": "husky",
    "publish-all-since": "YARN_CHANGESET_BASE_REFS=$0 yarn workspaces foreach --parallel --since --no-private --topological npm publish",
    "relink": "budsbox-update-ts-references",
    "scss-types": "typed-scss-modules packages",
    "setup": "run setup-builder & run setup-constraints & (run setup-eslint; run setup-eslint-worktree)",
    "setup-builder": "yarn workspace @budsbox/builder setup",
    "setup-constraints": "yarn workspace @budsbox/constraints setup",
    "setup-eslint": "yarn workspace @budsbox/eslint p:lib:setup",
    "setup-eslint-worktree": "yarn workspaces foreach --worktree --topological --parallel --from '@budsbox/eslint' run p:lib:setup",
    "setup-root": "run p:ts:build; echo \"$(run name) was set up successfully\"",
    "watch-scss-types": "run scss-types --watch"
  },
  "resolutions": {
    "eslint-module-utils@npm:^2.7.4": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch",
    "eslint-module-utils@npm:^2.8.0": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch"
  },
  "dependencies": {
    "@budsbox/build": "workspace:^",
    "@budsbox/builder": "workspace:^",
    "@budsbox/builder_vite": "workspace:^",
    "@budsbox/const": "workspace:^",
    "@budsbox/constraints": "workspace:^",
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_configs-import": "workspace:^",
    "@budsbox/eslint_configs-jsdoc": "workspace:^",
    "@budsbox/eslint_configs-prettier": "workspace:^",
    "@budsbox/eslint_configs-promise": "workspace:^",
    "@budsbox/eslint_configs-react": "workspace:^",
    "@budsbox/eslint_configs-typescript": "workspace:^",
    "@budsbox/eslint_presets-browser-app": "workspace:^",
    "@budsbox/eslint_presets-browser-lib": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/gen-mime-sniff-test-data": "workspace:^",
    "@budsbox/iso-utils": "workspace:^",
    "@budsbox/lib-class-name": "workspace:^",
    "@budsbox/lib-data-uri": "workspace:^",
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-extensions": "workspace:^",
    "@budsbox/lib-hooks": "workspace:^",
    "@budsbox/lib-mime": "workspace:^",
    "@budsbox/lib-node": "workspace:^",
    "@budsbox/lib-random": "workspace:^",
    "@budsbox/lib-react": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/lib-yarn": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/node-utils": "workspace:^",
    "@budsbox/parse-mime": "workspace:^",
    "@budsbox/playground": "workspace:^",
    "@budsbox/sass-importers": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@budsbox/ui-components-media": "workspace:^",
    "@budsbox/ui-components-merge-2": "workspace:^",
    "@budsbox/ui-tools": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@swc/cli": "^0.7.9",
    "@swc/core": "1.15.3",
    "@types/eslint": "^9.6.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.19.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.7.1",
    "@types/whatwg-mimetype": "^3.0.2",
    "@typescript-eslint/parser": "^8.48.1",
    "@typescript-eslint/type-utils": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@yarnpkg/cli": "^4.12.0",
    "@yarnpkg/core": "^4.5.0",
    "@yarnpkg/fslib": "^3.1.4",
    "@yarnpkg/sdks": "^3.2.3",
    "@yarnpkg/types": "^4.0.1",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "clsx": "^2.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-perfectionist": "*",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "execa": "^9.6.1",
    "globals": "^16.5.0",
    "meow": "^13.2.0",
    "micromatch": "^4.0.8",
    "mime-db": "*",
    "minimatch": "^10.2.0",
    "peggy": "^5.0.6",
    "prettier": "3.2.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.94.2",
    "sass-embedded": "^1.93.3",
    "semver": "^7.7.3",
    "sort-package-json": "^3.5.0",
    "ts-deepmerge": "^7.0.3",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1",
    "typed-scss-modules": "^8.1.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-dt-links": "^2.0.42",
    "typedoc-plugin-import-target": "^1.4.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-react-rich-svg": "^1.3.0",
    "vitest": "^4.0.15",
    "whatwg-mimetype": "^4.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "dependenciesMeta": {
    "typedoc-github-theme@0.4.0": {
      "unplugged": true
    }
  },
  "packageManager": "yarn@4.9.2"
}
