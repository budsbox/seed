{
  "name": "@budsbox/root",
  "private": true,
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "sideEffects": [
    "./**/*.scss"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "workspaces": [
    "./build",
    "./constraints",
    "./linting",
    "./tsconfigs",
    "./packages/*"
  ],
  "scripts": {
    "format": "yarn format-manifests && prettier --write .",
    "format-manifests": "sort-package-json \"**/package.json\"",
    "p:build": "cd $INIT_CWD; tsc && vite build",
    "p:eslint": "echo $INIT_CWD; cd $INIT_CWD; eslint --quiet .",
    "p:eslint:staged": "cd $INIT_CWD; eslint --quiet --no-warn-ignored",
    "p:serve": "cd $INIT_CWD; vite",
    "p:ts:build": "cd $INIT_CWD; tsc --build",
    "p:ts:check": "cd $INIT_CWD; tsc --project $INIT_CWD --noEmit",
    "p:ts:prepack": "cd $INIT_CWD; tsc --build --clean; tsc --build;",
    "p:ts:watch": "cd $INIT_CWD; yarn p:ts:build --watch --verbose",
    "p:wsd": "cd $INIT_CWD; yarn add @budsbox/$0",
    "playground": "yarn workspace @budsbox/playground p:serve",
    "prepare": "husky",
    "preview": "vite preview",
    "scss-types": "typed-scss-modules packages",
    "watch-scss-types": "yarn scss-types --watch",
    "ws": "yarn workspace"
  },
  "resolutions": {
    "eslint-module-utils@npm:^2.7.4": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch",
    "eslint-module-utils@npm:^2.8.0": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch"
  },
  "dependencies": {
    "@budsbox/constraints": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/sass-importers": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.9.1",
    "@types/eslint": "^8.56.12",
    "@types/node": "^20.16.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@yarnpkg/types": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "prettier": "3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.6",
    "sort-package-json": "^2.10.1",
    "tslib": "^2.7.0",
    "typed-scss-modules": "^8.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "husky": "^9.1.5",
    "lint-staged": "^15.2.9"
  },
  "packageManager": "yarn@4.4.0"
}
