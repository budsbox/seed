{
  "name": "@budsbox/root",
  "private": true,
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "sideEffects": [
    "./**/*.scss"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "workspaces": [
    "./build",
    "./linting",
    "./tsconfigs",
    "./packages/*"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "format": "yarn format-manifests && prettier --write .",
    "format-manifests": "sort-package-json \"package.json\"",
    "lint-staged": "lint-staged",
    "p:build": "cd $INIT_CWD; tsc && vite build",
    "p:eslint": "cd $INIT_CWD; eslint --quiet .",
    "p:serve": "cd $INIT_CWD; vite",
    "p:ts:build": "cd $INIT_CWD; tsc --build",
    "p:ts:check": "cd $INIT_CWD; tsc --project $INIT_CWD --noEmit",
    "p:ts:watch": "cd $INIT_CWD; yarn p:ts:build --watch --verbose",
    "playground": "yarn workspace @budsbox/playground p:serve",
    "prepare": "husky",
    "preview": "vite preview",
    "scss-types": "typed-scss-modules packages",
    "watch-scss-types": "yarn scss-types --watch",
    "ws": "yarn workspace"
  },
  "dependencies": {
    "@budsbox/linting": "workspace:^",
    "@budsbox/sass-importers": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.6.0",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@yarnpkg/types": "^4.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.8",
    "globals": "^15.8.0",
    "prettier": "3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.6",
    "sort-package-json": "^2.10.0",
    "tslib": "^2.6.3",
    "typed-scss-modules": "^8.0.1",
    "typescript": "5.5.3",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7"
  },
  "packageManager": "yarn@4.3.1"
}
