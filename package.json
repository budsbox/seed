{
  "name": "@budsbox/root",
  "private": true,
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "sideEffects": [
    "./**/*.scss"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "workspaces": [
    "./build",
    "./builder",
    "./constraints",
    "./lib/*",
    "./linting",
    "./lint/*",
    "./tsconfigs",
    "./packages/*"
  ],
  "scripts": {
    "c": "yarn constraints",
    "cf": "yarn constraints --fix; yarn",
    "format": "yarn format-manifests && prettier --write .",
    "format-manifests": "sort-package-json \"**/package.json\"",
    "postinstall": "yarn workspace @budsbox/builder setup; yarn relink",
    "lint-staged": "lint-staged --config .lintstagedrc.js",
    "name": "echo $npm_package_name",
    "p:build": "cd $INIT_CWD; tsc && vite build",
    "p:eslint": "echo $INIT_CWD; cd $INIT_CWD; eslint --quiet .",
    "p:eslint:fix": "echo $INIT_CWD; cd $INIT_CWD; eslint --quiet --fix .",
    "p:eslint:staged": "cd $INIT_CWD; eslint --quiet --no-warn-ignored",
    "p:format-manifest": "cd $INIT_CWD; sort-package-json package.json",
    "p:lib:build": "cd $INIT_CWD; budsbox-build-lib",
    "p:lint": "cd $INIT_CWD; yarn p:eslint",
    "p:prettier": "prettier --write $INIT_CWD/**",
    "p:scope-prefix": "$SHELL -c 'echo ${@/#/@budsbox/}' sh",
    "p:serve": "cd $INIT_CWD; vite",
    "p:ts:build": "cd $INIT_CWD; tsc --build",
    "p:ts:config": "cd $INIT_CWD; tsc --showConfig --project",
    "p:ts:check": "cd $INIT_CWD; tsc --project $INIT_CWD --noEmit",
    "p:ts:cjs": "cd $INIT_CWD; tsc --outDir dist/cjs --verbatimModuleSyntax false",
    "p:ts:prepack": "cd $INIT_CWD; tsc --build --clean; tsc --build;",
    "p:ts:prepack:cjs": "cd $INIT_CWD; npm pkg set type=commonjs; yarn p:ts:cjs --project tsconfig.lib.json; yarn p:ts:prepack:emit-cjs-pkg; npm pkg set type=module",
    "p:ts:prepack:dual": "cd $INIT_CWD; echo 'prepack esm...'; yarn p:ts:prepack; echo 'prepack commonjs...'; yarn p:ts:prepack:cjs",
    "p:ts:prepack:emit-cjs-pkg": "cd $INIT_CWD; echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json;",
    "p:ts:watch": "cd $INIT_CWD; yarn p:ts:build --watch --verbose",
    "p:wsa": "cd $INIT_CWD; yarn add $(yarn p:scope-prefix \"$@\")",
    "p:wsad": "cd $INIT_CWD; yarn add -D $(yarn p:scope-prefix \"$@\")",
    "p:wsap": "cd $INIT_CWD; yarn add -P $(yarn p:scope-prefix \"$@\")",
    "p:wsr": "cd $INIT_CWD; yarn remove $(yarn p:scope-prefix \"$@\")",
    "playground": "yarn workspace @budsbox/playground p:serve",
    "prepare": "husky",
    "preview": "vite preview",
    "relink": "yarn budsbox-update-ts-references",
    "scss-types": "typed-scss-modules packages",
    "setup": "yarn workspace @budsbox/builder prepack",
    "watch-scss-types": "yarn scss-types --watch",
    "ws": "yarn workspace"
  },
  "resolutions": {
    "eslint-module-utils@npm:^2.7.4": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch",
    "eslint-module-utils@npm:^2.8.0": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch"
  },
  "dependencies": {
    "@budsbox/build": "workspace:^",
    "@budsbox/builder": "workspace:^",
    "@budsbox/constraints": "workspace:^",
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint~presets-tools": "workspace:^",
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-extensions": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/lib-yarn": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/sass-importers": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.25.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@typescript-eslint/type-utils": "^8.31.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@yarnpkg/cli": "^4.8.1",
    "@yarnpkg/core": "^4.3.1",
    "@yarnpkg/fslib": "^3.1.2",
    "@yarnpkg/types": "^4.0.1",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import-x": "^4.11.0",
    "eslint-plugin-jsdoc": "^50.6.11",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "execa": "^9.5.2",
    "globals": "^16.0.0",
    "meow": "^13.2.0",
    "micromatch": "^4.0.8",
    "prettier": "3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.6",
    "sass-embedded": "^1.78.0",
    "sort-package-json": "^2.10.1",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typed-scss-modules": "^8.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1"
  },
  "packageManager": "yarn@4.8.1"
}
