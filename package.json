{
  "name": "@budsbox/root",
  "private": true,
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "sideEffects": [
    "./**/*.scss"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "workspaces": [
    "./build",
    "./builder",
    "./constraints",
    "./lib/*",
    "./linting",
    "./lint/*",
    "./tsconfigs",
    "./packages/*"
  ],
  "scripts": {
    "c": "run setup-constraints; yarn constraints",
    "cf": "yarn constraints --fix; yarn",
    "format": "run format-manifests && prettier --write .",
    "format-manifests": "sort-package-json \"**/package.json\"",
    "postinstall": "run setup-builder; run relink",
    "lint-staged": "lint-staged --config .lintstagedrc.js",
    "name": "echo $npm_package_name",
    "p:build": "cd $INIT_CWD; tsc && vite build",
    "p:eslint": "echo $INIT_CWD; cd $INIT_CWD; eslint --quiet ${@:-'.'}",
    "p:eslint:config": "echo $INIT_CWD; cd $INIT_CWD; eslint --print-config",
    "p:eslint:fix": "echo $INIT_CWD; cd $INIT_CWD; eslint --quiet --fix ${@:-'.'}",
    "p:eslint:staged": "cd $INIT_CWD; eslint --quiet --fix --no-warn-ignored --flag unstable_config_lookup_from_file",
    "p:format-manifest": "cd $INIT_CWD; sort-package-json package.json",
    "p:lib:build": "cd $INIT_CWD; budsbox-build-lib",
    "p:lib:setup": "cd $INIT_CWD; run p:ts:build-lib; echo \"$(run name) was set up successfully\"",
    "p:lint": "cd $INIT_CWD; run p:eslint",
    "p:prettier": "prettier --write $INIT_CWD/**",
    "p:scope-prefix": "$SHELL -c 'echo ${@/#/@budsbox/}' sh",
    "p:serve": "cd $INIT_CWD; vite",
    "p:ts:build": "cd $INIT_CWD; tsc --build",
    "p:ts:build-lib": "cd $INIT_CWD; tsc --build tsconfig.lib.json",
    "p:ts:clean": "cd $INIT_CWD; tsc --build --clean;",
    "p:ts:config": "cd $INIT_CWD; tsc --showConfig --project ${0:-'.'}",
    "p:ts:force": "cd $INIT_CWD; tsc --build --force",
    "p:ts:prepack": "cd $INIT_CWD; tsc --build --clean; tsc --build;",
    "p:ts:watch": "cd $INIT_CWD; run p:ts:build --watch --verbose",
    "p:wsa": "cd $INIT_CWD; yarn add $(run p:scope-prefix \"$@\")",
    "p:wsad": "cd $INIT_CWD; yarn add -D $(run p:scope-prefix \"$@\")",
    "p:wsap": "cd $INIT_CWD; yarn add -P $(run p:scope-prefix \"$@\")",
    "p:wsr": "cd $INIT_CWD; yarn remove $(run p:scope-prefix \"$@\")",
    "playground": "yarn workspace @budsbox/playground p:serve",
    "prepare": "husky",
    "preview": "vite preview",
    "relink": "budsbox-update-ts-references",
    "scss-types": "typed-scss-modules packages",
    "setup": "run setup-builder & run setup-constraints & (run setup-eslint; run setup-eslint-worktree)",
    "setup-builder": "yarn workspace @budsbox/builder setup",
    "setup-constraints": "yarn workspace @budsbox/constraints p:lib:setup",
    "setup-eslint": "yarn workspace @budsbox/eslint p:lib:setup",
    "setup-eslint-worktree": "yarn workspaces foreach --worktree --topological --parallel --from '@budsbox/eslint' run p:lib:setup",
    "setup-root": "run p:ts:build; echo \"$(run name) was set up successfully\"",
    "watch-scss-types": "run scss-types --watch",
    "ws": "yarn workspace"
  },
  "resolutions": {
    "eslint-module-utils@npm:^2.7.4": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch",
    "eslint-module-utils@npm:^2.8.0": "patch:eslint-module-utils@npm%3A2.8.0#~/.yarn/patches/eslint-module-utils-npm-2.8.0-05e42bcab0.patch"
  },
  "dependencies": {
    "@budsbox/build": "workspace:^",
    "@budsbox/builder": "workspace:^",
    "@budsbox/constraints": "workspace:^",
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint~presets-tools": "workspace:^",
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-extensions": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/lib-yarn": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/sass-importers": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/eslint": "^9.6.1",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.32.1",
    "@typescript-eslint/type-utils": "^8.32.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@yarnpkg/cli": "^4.8.1",
    "@yarnpkg/core": "^4.3.1",
    "@yarnpkg/fslib": "^3.1.2",
    "@yarnpkg/types": "^4.0.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import-x": "^4.11.1",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "execa": "^9.5.2",
    "globals": "^16.1.0",
    "meow": "^13.2.0",
    "micromatch": "^4.0.8",
    "prettier": "3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.6",
    "sass-embedded": "^1.78.0",
    "sort-package-json": "^2.10.1",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typed-scss-modules": "^8.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1"
  },
  "packageManager": "yarn@4.8.1"
}
