{
  "name": "@budsbox/root",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "./**/*.scss"
  ],
  "type": "module",
  "imports": {
    "#tsconfig.json": "./tsconfig.json",
    "#tsconfig.node.json": "./tsconfig.node.json"
  },
  "exports": {
    "./tsconfig.json": "./tsconfig.json",
    "./tsconfig.node.json": "./tsconfig.node.json"
  },
  "workspaces": [
    "./build",
    "./packages/*"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "eslint": "eslint --quiet .",
    "format": "yarn format-manifests && prettier --write .",
    "format-manifests": "sort-package-json \"package.json\"",
    "lint-staged": "lint-staged",
    "package:build": "cd $INIT_CWD; tsc && vite build",
    "package:serve": "cd $INIT_CWD; vite",
    "package:tscheck": "tsc --noEmit --project $INIT_CWD",
    "playground": "yarn workspace @budsbox/playground package:serve",
    "prepare": "husky",
    "preview": "vite preview",
    "scss-types": "typed-scss-modules packages",
    "watch-scss-types": "yarn scss-types --watch",
    "ws": "yarn workspace"
  },
  "dependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@yarnpkg/types": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "glob": "^10.4.2",
    "prettier": "3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.6",
    "sort-package-json": "^2.10.0",
    "typed-scss-modules": "^8.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7"
  },
  "packageManager": "yarn@4.1.1"
}
