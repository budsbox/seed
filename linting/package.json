{
  "name": "@budsbox/linting",
  "version": "1.3.2",
  "homepage": "https://github.com/budsbox/seed",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#eslint": {
      "import": {
        "types": "./dist/eslint/index.d.ts",
        "default": "./dist/eslint/index.js"
      },
      "require": {
        "types": "./dist/cjs/eslint/index.d.ts",
        "default": "./dist/cjs/eslint/index.js"
      }
    },
    "#match": {
      "import": {
        "types": "./dist/match.d.ts",
        "default": "./dist/match.js"
      },
      "require": {
        "types": "./dist/cjs/match.d.ts",
        "default": "./dist/cjs/match.js"
      }
    },
    "#package.json": "./package.json"
  },
  "exports": {
    "./eslint": {
      "import": {
        "types": "./dist/eslint/index.d.ts",
        "default": "./dist/eslint/index.js"
      },
      "require": {
        "types": "./dist/cjs/eslint/index.d.ts",
        "default": "./dist/cjs/eslint/index.js"
      }
    },
    "./match": {
      "import": {
        "types": "./dist/match.d.ts",
        "default": "./dist/match.js"
      },
      "require": {
        "types": "./dist/cjs/match.d.ts",
        "default": "./dist/cjs/match.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.ts",
    "dist/cjs/package.json"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/iso-utils": "workspace:^",
    "@budsbox/node-utils": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@types/eslint": "^9.6.1",
    "micromatch": "^4.0.8",
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.19.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "peerDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-refresh": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.9.2"
}
