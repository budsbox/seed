{
  "name": "@budsbox/linting",
  "version": "1.3.2",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#eslint": {
      "import": {
        "default": "./dist/eslint/index.js",
        "types": "./dist/eslint/index.d.ts"
      },
      "require": {
        "default": "./dist/cjs/eslint/index.js",
        "types": "./dist/cjs/eslint/index.d.ts"
      }
    },
    "#match": {
      "import": {
        "default": "./dist/match.js",
        "types": "./dist/match.d.ts"
      },
      "require": {
        "default": "./dist/cjs/match.js",
        "types": "./dist/cjs/match.d.ts"
      }
    },
    "#package.json": "./package.json"
  },
  "exports": {
    "./eslint": {
      "import": {
        "default": "./dist/eslint/index.js",
        "types": "./dist/eslint/index.d.ts"
      },
      "require": {
        "default": "./dist/cjs/eslint/index.js",
        "types": "./dist/cjs/eslint/index.d.ts"
      }
    },
    "./match": {
      "import": {
        "default": "./dist/match.js",
        "types": "./dist/match.d.ts"
      },
      "require": {
        "default": "./dist/cjs/match.js",
        "types": "./dist/cjs/match.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.ts",
    "dist/cjs/package.json"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/iso-utils": "workspace:^",
    "@budsbox/node-utils": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@types/eslint": "^9.6.1",
    "micromatch": "^4.0.8",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.15.2",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import-x": "^4.11.1",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "peerDependencies": {
    "@eslint/js": "^9.26.0",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-refresh": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.8.1"
}
