{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    // Language and Environment
    "jsx": "react-jsx",
    // Modules
    "moduleResolution": "bundler",
    "lib": [
      "ES5",
      "ES2015",
      "ES2016",
      "ES2018",
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
