{
  "name": "@budsbox/types",
  "version": "2.0.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#@": {
      "import": {
        "types": "./dist/esm/index.d.ts"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts"
      }
    },
    "#es.d.ts": {
      "import": {
        "types": "./es.d.ts"
      },
      "require": {
        "types": "./es.d.ts"
      }
    },
    "#package.json": "./package.json",
    "#object": {
      "import": {
        "types": "./dist/esm/object.d.ts"
      },
      "require": {
        "types": "./dist/cjs/object.d.ts"
      }
    },
    "#string": {
      "import": {
        "types": "./dist/esm/string.d.ts"
      },
      "require": {
        "types": "./dist/cjs/string.d.ts"
      }
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts"
      }
    },
    "./es.d.ts": {
      "import": {
        "types": "./es.d.ts"
      },
      "require": {
        "types": "./es.d.ts"
      }
    },
    "./package.json": "./package.json",
    "./object": {
      "import": {
        "types": "./dist/esm/object.d.ts"
      },
      "require": {
        "types": "./dist/cjs/object.d.ts"
      }
    },
    "./string": {
      "import": {
        "types": "./dist/esm/string.d.ts"
      },
      "require": {
        "types": "./dist/cjs/string.d.ts"
      }
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/cjs/package.json",
    "es.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack:dual"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.2",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "packageManager": "yarn@4.9.2"
}
