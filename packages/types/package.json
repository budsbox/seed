{
  "name": "@budsbox/types",
  "version": "2.0.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#@": {
      "import": {
        "types": "./dist/esm/index.d.ts"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts"
      }
    },
    "#es.d.ts": {
      "import": {
        "types": "./es.d.ts"
      },
      "require": {
        "types": "./es.d.ts"
      }
    },
    "#package.json": "./package.json",
    "#object": {
      "import": {
        "types": "./dist/esm/object.d.ts"
      },
      "require": {
        "types": "./dist/cjs/object.d.ts"
      }
    },
    "#string": {
      "import": {
        "types": "./dist/esm/string.d.ts"
      },
      "require": {
        "types": "./dist/cjs/string.d.ts"
      }
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts"
      }
    },
    "./es.d.ts": {
      "import": {
        "types": "./es.d.ts"
      },
      "require": {
        "types": "./es.d.ts"
      }
    },
    "./package.json": "./package.json",
    "./object": {
      "import": {
        "types": "./dist/esm/object.d.ts"
      },
      "require": {
        "types": "./dist/cjs/object.d.ts"
      }
    },
    "./string": {
      "import": {
        "types": "./dist/esm/string.d.ts"
      },
      "require": {
        "types": "./dist/cjs/string.d.ts"
      }
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/cjs/package.json",
    "es.d.ts"
  ],
  "scripts": {
    "prepack": "yarn p:ts:prepack:dual"
  },
  "devDependencies": {
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.14.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "packageManager": "yarn@4.5.3"
}
