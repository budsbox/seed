{
  "name": "@budsbox/types",
  "version": "1.1.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#@": {
      "import": {
        "types": "./dist/esm/index.d.ts"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts"
      }
    },
    "#es.d.ts": {
      "import": {
        "types": "./es.d.ts"
      },
      "require": {
        "types": "./es.d.ts"
      }
    },
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts"
      }
    },
    "./es.d.ts": {
      "import": {
        "types": "./es.d.ts"
      },
      "require": {
        "types": "./es.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "files": [
    "/dist",
    "/es.d.ts"
  ],
  "scripts": {
    "prepack": "yarn p:ts:prepack:dual"
  },
  "devDependencies": {
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.9.1",
    "@types/node": "^20.16.2",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  },
  "packageManager": "yarn@4.4.0"
}
