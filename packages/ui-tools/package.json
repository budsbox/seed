{
  "name": "@budsbox/ui-tools",
  "version": "0.1.0",
  "homepage": "https://github.com/budsbox/seed",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#@": {
      "require": {
        "default": "./dist/sass-importer.cjs",
        "types": "./dist/sass-importer.d.cts.map"
      }
    },
    "#colors": {
      "sass": "./src/colors/index.scss"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./dist/sass-importer.d.cts.map",
        "default": "./dist/sass-importer.cjs"
      }
    },
    "./colors": {
      "sass": "./src/colors/index.scss"
    }
  },
  "files": [
    "dist/**/*.{js,cjs,ts,cts}",
    "src/**/*.scss"
  ],
  "scripts": {
    "name": "echo $npm_package_name"
  },
  "dependencies": {
    "@budsbox/iso-utils": "workspace:^",
    "@budsbox/sass-importers": "workspace:^"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sass": "^1.94.2",
    "sass-embedded": "^1.93.3",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "peerDependencies": {
    "sass": "^1.94.2",
    "sass-embedded": "^1.93.3"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.9.2"
}
