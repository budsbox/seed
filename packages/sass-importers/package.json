  "scripts": {
    "prepack": "yarn p:ts:build"
  },
  "devDependencies": {
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@types/node": "^20.14.10",
    "tslib": "^2.6.3"
  },
  "packageManager": "yarn@4.3.1"
}
