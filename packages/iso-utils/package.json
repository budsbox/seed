{
  "name": "@budsbox/iso-utils",
  "version": "1.3.0",
  "description": "isomorphic (aka runtime-agnostic/independent) utilities",
  "homepage": "https://github.com/budsbox/seed",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "commonjs",
  "imports": {
    "#object": {
      "import": {
        "types": "./dist/object.d.ts",
        "default": "./dist/object.js"
      },
      "require": {
        "types": "./dist/object.d.ts",
        "default": "./dist/object.js"
      }
    },
    "#type-guards": {
      "import": {
        "types": "./dist/type-guards.d.ts",
        "default": "./dist/type-guards.js"
      },
      "require": {
        "types": "./dist/type-guards.d.ts",
        "default": "./dist/type-guards.js"
      }
    },
    "#package.json": "./package.json",
    "#string": {
      "import": {
        "types": "./dist/string.d.ts",
        "default": "./dist/string.js"
      },
      "require": {
        "types": "./dist/string.d.ts",
        "default": "./dist/string.js"
      }
    },
    "#logical": {
      "import": {
        "types": "./dist/logical.d.ts",
        "default": "./dist/logical.js"
      },
      "require": {
        "types": "./dist/logical.d.ts",
        "default": "./dist/logical.js"
      }
    }
  },
  "exports": {
    "./object": {
      "import": {
        "types": "./dist/object.d.ts",
        "default": "./dist/object.js"
      },
      "require": {
        "types": "./dist/object.d.ts",
        "default": "./dist/object.js"
      }
    },
    "./string": {
      "import": {
        "types": "./dist/string.d.ts",
        "default": "./dist/string.js"
      },
      "require": {
        "types": "./dist/string.d.ts",
        "default": "./dist/string.js"
      }
    },
    "./type-guards": {
      "import": {
        "types": "./dist/type-guards.d.ts",
        "default": "./dist/type-guards.js"
      },
      "require": {
        "types": "./dist/type-guards.d.ts",
        "default": "./dist/type-guards.js"
      }
    },
    "./logical": {
      "import": {
        "types": "./dist/logical.d.ts",
        "default": "./dist/logical.js"
      },
      "require": {
        "types": "./dist/logical.d.ts",
        "default": "./dist/logical.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/types": "workspace:^"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "packageManager": "yarn@4.9.2"
}
