{
  "name": "@budsbox/iso-utils",
  "version": "1.0.1",
  "description": "isomorphic (aka runtime-agnostic/independent) utilities",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#object": {
      "import": "./dist/object.js",
      "types": "./dist/object.d.ts"
    },
    "#type-guards": {
      "import": "./dist/type-guards.js",
      "types": "./dist/type-guards.d.ts"
    },
    "#package.json": "./package.json",
    "#string": {
      "import": "./dist/string.js",
      "types": "./dist/string.d.ts"
    },
    "#logical": {
      "import": "./dist/logical.js",
      "types": "./dist/logical.d.ts"
    }
  },
  "exports": {
    "./object": {
      "import": "./dist/object.js",
      "types": "./dist/object.d.ts"
    },
    "./string": {
      "import": "./dist/string.js",
      "types": "./dist/string.d.ts"
    },
    "./type-guards": {
      "import": "./dist/type-guards.js",
      "types": "./dist/type-guards.d.ts"
    },
    "./logical": {
      "import": "./dist/logical.js",
      "types": "./dist/logical.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/types": "workspace:^"
  },
  "devDependencies": {
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.9.1",
    "@types/node": "^20.16.2",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  },
  "packageManager": "yarn@4.4.0"
}
