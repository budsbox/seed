{
  "name": "@budsbox/iso-utils",
  "version": "1.2.0",
  "description": "isomorphic (aka runtime-agnostic/independent) utilities",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "commonjs",
  "imports": {
    "#object": {
      "import": {
        "default": "./dist/object.js",
        "types": "./dist/object.d.ts"
      },
      "require": {
        "default": "./dist/object.js",
        "types": "./dist/object.d.ts"
      }
    },
    "#type-guards": {
      "import": {
        "default": "./dist/type-guards.js",
        "types": "./dist/type-guards.d.ts"
      },
      "require": {
        "default": "./dist/type-guards.js",
        "types": "./dist/type-guards.d.ts"
      }
    },
    "#package.json": "./package.json",
    "#string": {
      "import": {
        "default": "./dist/string.js",
        "types": "./dist/string.d.ts"
      },
      "require": {
        "default": "./dist/string.js",
        "types": "./dist/string.d.ts"
      }
    },
    "#logical": {
      "import": {
        "default": "./dist/logical.js",
        "types": "./dist/logical.d.ts"
      },
      "require": {
        "default": "./dist/logical.js",
        "types": "./dist/logical.d.ts"
      }
    }
  },
  "exports": {
    "./object": {
      "import": {
        "default": "./dist/object.js",
        "types": "./dist/object.d.ts"
      },
      "require": {
        "default": "./dist/object.js",
        "types": "./dist/object.d.ts"
      }
    },
    "./string": {
      "import": {
        "default": "./dist/string.js",
        "types": "./dist/string.d.ts"
      },
      "require": {
        "default": "./dist/string.js",
        "types": "./dist/string.d.ts"
      }
    },
    "./type-guards": {
      "import": {
        "default": "./dist/type-guards.js",
        "types": "./dist/type-guards.d.ts"
      },
      "require": {
        "default": "./dist/type-guards.js",
        "types": "./dist/type-guards.d.ts"
      }
    },
    "./logical": {
      "import": {
        "default": "./dist/logical.js",
        "types": "./dist/logical.d.ts"
      },
      "require": {
        "default": "./dist/logical.js",
        "types": "./dist/logical.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/types": "workspace:^"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.14.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "packageManager": "yarn@4.8.1"
}
