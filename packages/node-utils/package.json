{
  "name": "@budsbox/node-utils",
  "version": "1.1.0",
  "description": "NodeJS utilities",
  "homepage": "https://github.com/budsbox/seed",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#tsconfig": {
      "import": {
        "types": "./dist/esm/tsconfig.d.ts",
        "default": "./dist/esm/tsconfig.js"
      }
    },
    "#fs": {
      "import": {
        "types": "./dist/esm/fs.d.ts",
        "default": "./dist/esm/fs.js"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./tsconfig": {
      "import": {
        "types": "./dist/esm/tsconfig.d.ts",
        "default": "./dist/esm/tsconfig.js"
      }
    },
    "./fs": {
      "import": {
        "types": "./dist/esm/fs.d.ts",
        "default": "./dist/esm/fs.js"
      }
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/iso-utils": "workspace:^",
    "execa": "^9.6.1",
    "package-up": "^5.0.0",
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.9.2"
}
