{
  "name": "@budsbox/node-utils",
  "version": "1.0.6",
  "description": "NodeJS utilities",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#tsconfig": {
      "import": {
        "default": "./dist/esm/tsconfig.js",
        "types": "./dist/esm/tsconfig.d.ts"
      }
    },
    "#fs": {
      "import": {
        "default": "./dist/esm/fs.js",
        "types": "./dist/esm/fs.d.ts"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./tsconfig": {
      "import": {
        "default": "./dist/esm/tsconfig.js",
        "types": "./dist/esm/tsconfig.d.ts"
      }
    },
    "./fs": {
      "import": {
        "default": "./dist/esm/fs.js",
        "types": "./dist/esm/fs.d.ts"
      }
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/iso-utils": "workspace:^",
    "execa": "^9.5.2",
    "package-up": "^5.0.0",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@budsbox/types": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.2",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.9.2"
}
