{
  "name": "@budsbox/lib-hooks",
  "version": "0.0.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "sideEffects": [
    "./**/*.scss",
    "./**/*.css"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "import": {
        "production": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.mjs"
        },
        "development": {
          "default": "./src/index.ts"
        }
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.css"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn vite build; yarn p:ts:build",
    "serve": "vite"
  },
  "dependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@budsbox/builder_vite": "workspace:^",
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-browser-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.2",
    "@vitejs/plugin-react": "^5.0.3",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "clsx": "^2.1.1",
    "eslint": "^9.26.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass-embedded": "^1.92.1",
    "type-fest": "^4.32.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.5"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "packageManager": "yarn@4.9.2"
}
