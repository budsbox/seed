{
  "name": "@budsbox/lib-es",
  "version": "3.0.0",
  "homepage": "https://github.com/budsbox/seed/tree/trunk/lib/es",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#types": "./dist/types.d.ts",
    "#array": {
      "types": "./dist/array.d.ts",
      "default": "./dist/array.js"
    },
    "#object": {
      "types": "./dist/object.d.ts",
      "default": "./dist/object.js"
    },
    "#string": {
      "types": "./dist/string.d.ts",
      "default": "./dist/string.js"
    },
    "#guards": {
      "types": "./dist/guards/index.d.ts",
      "default": "./dist/guards/index.js"
    },
    "#guards/*": {
      "types": "./dist/guards/*.d.ts",
      "default": "./dist/guards/*.js"
    },
    "#logical": {
      "types": "./dist/logical.d.ts",
      "default": "./dist/logical.js"
    },
    "#function": {
      "types": "./dist/function.d.ts",
      "default": "./dist/function.js"
    },
    "#set": {
      "types": "./dist/set.d.ts",
      "default": "./dist/set.js"
    },
    "#map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    }
  },
  "exports": {
    "./array": {
      "types": "./dist/array.d.ts",
      "default": "./dist/array.js"
    },
    "./object": {
      "types": "./dist/object.d.ts",
      "default": "./dist/object.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "default": "./dist/string.js"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "default": "./dist/guards/index.js"
    },
    "./logical": {
      "types": "./dist/logical.d.ts",
      "default": "./dist/logical.js"
    },
    "./function": {
      "types": "./dist/function.d.ts",
      "default": "./dist/function.js"
    },
    "./set": {
      "types": "./dist/set.d.ts",
      "default": "./dist/set.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "run p:ts:build",
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack",
    "test": "run p:vitest",
    "watch": "yarn p:ts:watch"
  },
  "dependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@types/node": "^24",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.39.4",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.0"
  },
  "packageManager": "yarn@4.13.0"
}
