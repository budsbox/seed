{
  "name": "@budsbox/lib-es",
  "version": "2.3.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#array": {
      "types": "./dist/array.d.ts",
      "default": "./dist/array.js"
    },
    "#object": {
      "types": "./dist/object.d.ts",
      "default": "./dist/object.js"
    },
    "#string": {
      "types": "./dist/string.d.ts",
      "default": "./dist/string.js"
    },
    "#guards": {
      "types": "./dist/guards.d.ts",
      "default": "./dist/guards.js"
    },
    "#logical": {
      "types": "./dist/logical.d.ts",
      "default": "./dist/logical.js"
    },
    "#function": {
      "types": "./dist/function.d.ts",
      "default": "./dist/function.js"
    }
  },
  "exports": {
    "./array": {
      "types": "./dist/array.d.ts",
      "default": "./dist/array.js"
    },
    "./object": {
      "types": "./dist/object.d.ts",
      "default": "./dist/object.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "default": "./dist/string.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "default": "./dist/guards.js"
    },
    "./logical": {
      "types": "./dist/logical.d.ts",
      "default": "./dist/logical.js"
    },
    "./function": {
      "types": "./dist/function.d.ts",
      "default": "./dist/function.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/lib-types": "workspace:^",
    "@types/node": "^22.15.2",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.26.0",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import-x": "^4.11.1",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "packageManager": "yarn@4.9.2"
}
