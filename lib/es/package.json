      "import": {
        "default": "./dist/array.js",
        "types": "./dist/array.d.ts"
      }
    },
    "#object": {
      "import": {
        "default": "./dist/object.js",
        "types": "./dist/object.d.ts"
      }
    },
    "#string": {
      "import": {
        "default": "./dist/string.js",
        "types": "./dist/string.d.ts"
      }
    },
    "#guards": {
      "import": {
        "default": "./dist/guards.js",
        "types": "./dist/guards.d.ts"
      }
    },
    "#logical": {
      "import": {
        "default": "./dist/logical.js",
        "types": "./dist/logical.d.ts"
      }
    }
  },
  "exports": {
    "./array": {
      "import": {
        "default": "./dist/array.js",
        "types": "./dist/array.d.ts"
      }
    },
    "./object": {
      "import": {
        "default": "./dist/object.js",
        "types": "./dist/object.d.ts"
      }
    },
    "./string": {
      "import": {
        "default": "./dist/string.js",
        "types": "./dist/string.d.ts"
      }
    },
    "./guards": {
      "import": {
        "default": "./dist/guards.js",
        "types": "./dist/guards.d.ts"
      }
    },
    "./logical": {
      "import": {
        "default": "./dist/logical.js",
        "types": "./dist/logical.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/lib-types": "workspace:^",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint~config-import": "workspace:^",
    "@budsbox/eslint~config-typescript": "workspace:^",
    "@budsbox/linting": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.10.0",
    "eslint-plugin-import-x": "^4.10.5",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "packageManager": "yarn@4.8.1"
}
