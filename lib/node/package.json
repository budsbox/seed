  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#ts": {
      "import": "./dist/ts.js",
      "types": "./dist/ts.d.ts"
    },
    "#fs": {
      "import": "./dist/fs.js",
      "types": "./dist/fs.d.ts"
    },
    "#pckg": {
      "import": "./dist/pckg.js",
      "types": "./dist/pckg.d.ts"
    },
    "#types": {
      "types": "./dist/types.d.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./ts": {
      "import": "./dist/ts.js",
      "types": "./dist/ts.d.ts"
    },
    "./fs": {
      "import": "./dist/fs.js",
      "types": "./dist/fs.d.ts"
    },
    "./pckg": {
      "import": "./dist/pckg.js",
      "types": "./dist/pckg.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@budsbox/types": "workspace:^",
