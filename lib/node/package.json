{
  "name": "@budsbox/lib-node",
  "version": "1.1.1",
  "homepage": "https://github.com/budsbox/seed",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#ts": {
      "types": "./dist/ts.d.ts",
      "import": "./dist/ts.js"
    },
    "#fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "#pckg": {
      "types": "./dist/pckg.d.ts",
      "import": "./dist/pckg.js"
    },
    "#types": {
      "types": "./dist/types.d.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./ts": {
      "types": "./dist/ts.d.ts",
      "import": "./dist/ts.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "./pckg": {
      "types": "./dist/pckg.d.ts",
      "import": "./dist/pckg.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "yarn p:ts:prepack"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "execa": "^9.6.1",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-node-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.1",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "peerDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.13.0"
}
