{
  "name": "@budsbox/lib-types",
  "version": "1.3.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#core": {
      "types": "./dist/core.d.ts"
    },
    "#object": {
      "types": "./dist/object.d.ts"
    },
    "#es.d.ts": {
      "types": "./es.d.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core.d.ts"
    },
    "./object": {
      "types": "./dist/object.d.ts"
    },
    "./es.d.ts": {
      "types": "./es.d.ts"
    },
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/*.ts",
    "es.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.2",
    "eslint": "^9.26.0",
    "type-fest": "^4.32.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@types/node": "^22.15.2",
    "type-fest": "^4.32.0"
  },
  "packageManager": "yarn@4.9.2"
}
