{
  "name": "@budsbox/lib-types",
  "version": "1.3.0",
  "homepage": "https://github.com/budsbox/seed",
  "bugs": {
    "url": "https://github.com/budsbox/seed/issues"
  },
  "repository": "git@github.com:budsbox/seed.git",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#array": {
      "types": "./dist/array.d.ts"
    },
    "#core": {
      "types": "./dist/core.d.ts"
    },
    "#function": {
      "types": "./dist/function.d.ts"
    },
    "#object": {
      "types": "./dist/object.d.ts"
    },
    "#es.d.ts": {
      "types": "./es.d.ts"
    },
    "#exec-dependency": {
      "types": "./exec-dependency.d.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./es.d.ts": {
      "types": "./es.d.ts"
    },
    "./exec-dependency": {
      "types": "./exec-dependency.d.ts"
    },
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/*.ts",
    "es.d.ts"
  ],
  "scripts": {
    "name": "echo $npm_package_name",
    "prepack": "run p:ts:prepack",
    "test": "run p:vitest:watch"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "@types/node": "^22.19.1",
    "type-fest": "^5.3.1"
  },
  "packageManager": "yarn@4.9.2"
}
