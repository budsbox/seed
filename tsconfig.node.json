{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "typed-scss-modules.config.ts",
    "./**/*.mjs",
    "./**/*.mjs.d.ts"
  ]
}
