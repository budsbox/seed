{
  "name": "@budsbox/parse-mime",
  "version": "1.0.0",
  "homepage": "https://gitlab.com/budsbox/fe/seed",
  "bugs": {
    "url": "https://gitlab.com/budsbox/fe/seed/-/issues"
  },
  "repository": "gitlab:budsbox/fe/seed",
  "license": "MIT",
  "author": "Konstantin Kutsyllo <trikadin@pm.me>",
  "type": "module",
  "imports": {
    "#parser": {
      "import": {
        "types": "./dist/parser.d.ts",
        "default": "./dist/parser.js"
      }
    },
    "#types": {
      "types": "./dist/types.d.ts",
      "budsbox": "./src/types.ts"
    },
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "@budsbox/": "./src/index.ts",
        "production": "./dist/index.min.js",
        "default": "./dist/index.js"
      },
      "require": "./dist/index.min.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "run p:peggy:build; run p:ts:build",
    "name": "echo $npm_package_name",
    "prepack": "run p:peggy:prepack; run p:ts:prepack",
    "test": "vitest",
    "trace": "run p:ts:watch:no-clear & run p:peggy:trace",
    "watch": "run p:ts:watch:no-clear & run p:peggy:watch"
  },
  "dependencies": {
    "@budsbox/lib-es": "workspace:^",
    "@budsbox/lib-types": "workspace:^",
    "@types/node": "^22.19.1",
    "tslib": "^2.8.1",
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@budsbox/eslint": "workspace:^",
    "@budsbox/eslint_presets-lib": "workspace:^",
    "@budsbox/eslint_presets-tools": "workspace:^",
    "@budsbox/tsconfigs": "workspace:^",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.39.1",
    "mime-sniff-test-data": "exec:./exec-dependencies/mime-sniff-test-data.cjs",
    "peggy": "^5.0.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "packageManager": "yarn@4.9.2"
}
